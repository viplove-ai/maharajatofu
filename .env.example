# Copy to .env.local for development. .env.local is gitignored.

# Neon connection string. Use the POOLED endpoint (the one with `-pooler`):
# @neondatabase/serverless speaks HTTP and holds no prepared-statement state, so
# unlike nirman's Hikari pool there is nothing here for PgBouncer to break.
#
# Separate database from nirman inside the same Neon project:
#   psql '<nirman connection string>' -c 'CREATE DATABASE maharaja_tofu;'
# then swap the database name at the end of the URL.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/maharaja_tofu?sslmode=require

# Public — these end up in the client bundle. Nothing secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=910000000000
NEXT_PUBLIC_FSSAI=FSSAI registration in progress
