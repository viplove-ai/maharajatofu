{
  "meta": {
    "brand": "Maharaja Tofu",
    "direction": "Enamel Board",
    "radius": "0 — square corners are the system",
    "shadows": "none"
  },
  "color": {
    "indigo": "#14224A",
    "indigo-raise": "#1B2C58",
    "ink": "#0E1526",
    "cream": "#F4EBDA",
    "paper": "#FBF7EE",
    "stone": "#DCD3C0",
    "stone-edge": "#C9C0AC",
    "grey-warm": "#7E7768",
    "grey-warm-dark": "#6E6757",
    "slate": "#2A3350",
    "vermilion": "#E1442A",
    "marigold": "#F2A118",
    "chilli": "#B4202A",
    "green": "#1E7B34",
    "placeholder-text": "#A8A08C",
    "track-off": "#B9B09C"
  },
  "skuColor": {
    "classic": "#F2A118",
    "masala": "#B4202A"
  },
  "font": {
    "devanagariDisplay": "'Yatra One', serif",
    "headline": "Mukta, sans-serif",
    "latinDisplay": "'Archivo Black', Archivo, sans-serif",
    "body": "Archivo, Helvetica, sans-serif",
    "mono": "'IBM Plex Mono', monospace"
  },
  "typeMobile": {
    "heroDevanagari": {
      "family": "Mukta",
      "weight": 800,
      "size": 40,
      "lineHeight": 1.1
    },
    "sectionHeadline": {
      "family": "Mukta",
      "weight": 800,
      "size": 24,
      "lineHeight": 1.25
    },
    "bigNumber": {
      "family": "Archivo Black",
      "size": 60,
      "lineHeight": 0.9
    },
    "kcalNumber": {
      "family": "Archivo Black",
      "size": 54,
      "lineHeight": 1
    },
    "skuName": {
      "family": "Archivo Black",
      "size": 17,
      "letterSpacing": "0.03em"
    },
    "eyebrow": {
      "family": "IBM Plex Mono",
      "size": 10,
      "letterSpacing": "0.20em",
      "transform": "uppercase"
    },
    "body": {
      "family": "Archivo",
      "size": 14,
      "lineHeight": 1.55
    },
    "button": {
      "family": "Mukta",
      "weight": 800,
      "size": 17
    },
    "ingredientHero": {
      "family": "IBM Plex Mono",
      "weight": 600,
      "size": 27,
      "lineHeight": 1.5
    },
    "legal": {
      "family": "IBM Plex Mono",
      "size": 10,
      "lineHeight": 1.8
    }
  },
  "typeDesktop": {
    "heroDevanagari": {
      "size": 68,
      "lineHeight": 1.05
    },
    "sectionHeadline": {
      "size": 32
    },
    "bigNumber": {
      "size": 76
    },
    "body": {
      "size": 16,
      "lineHeight": 1.6
    }
  },
  "space": {
    "xs": 8,
    "sm": 10,
    "md": 14,
    "lg": 16,
    "xl": 24,
    "sectionMobile": "26px 20px",
    "sectionDesktop": "44px 40px"
  },
  "control": {
    "minTarget": 44,
    "input": 56,
    "primaryButton": 58,
    "chip": 52,
    "stickyBar": 56
  },
  "border": {
    "hairline": "1px solid #DCD3C0",
    "input": "2px solid #14224A",
    "sectionRule": "3px solid #E1442A",
    "skuBar": "8px",
    "pullQuote": "4px solid #14224A"
  },
  "motion": {
    "transition": "140ms ease-out (colour/opacity only)",
    "spinner": "0.8s linear ring",
    "forbidden": [
      "count-up numbers",
      "parallax",
      "reveal-on-scroll",
      "countdown timers"
    ]
  },
  "placeholderFill": {
    "onIndigo": "repeating-linear-gradient(45deg, #1B2C58 0 7px, #22345F 7px 14px)",
    "onCream": "repeating-linear-gradient(45deg, #E6DBC4 0 6px, #EFE6D2 6px 12px)"
  }
}